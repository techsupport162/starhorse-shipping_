# Applicant resumes must never be served directly by URL — they are only

# ever streamed through the admin-authenticated

# modules/career/applicants/ajax/download_resume.php endpoint. This

# folder is otherwise a normal upload directory (see

# functions/helpers.php: store_uploaded_document() / store_uploaded_image()),

# so lock all direct web access down at the web-server level as

# defense in depth alongside that application-level control.

# Apache 2.4+

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 (fallback for older hosting)

<IfModule !mod_authz_core.c>
Order deny,allow
Deny from all
</IfModule>
