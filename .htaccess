# -----------------------------------------------------------------------
# Site-wide web server hardening (Apache 2.4, mod_php or PHP-FPM)
# -----------------------------------------------------------------------
# The landing page's own Content-Security-Policy is sent from index.php
# (includes/security.php) so it sits next to the markup it describes; the
# CSP below is only a baseline that also covers the admin panel and every
# static file. Browsers enforce both policies together.
#
# If the site is ever moved to Nginx/IIS, none of this file applies — the
# same rules must be re-created in that server's own configuration.
# -----------------------------------------------------------------------

# ---- Directory listing / content negotiation / server banner ----------
Options -Indexes -MultiViews
ServerSignature Off

# Always serve the PHP landing page, never the leftover index.html template.
DirectoryIndex index.php

# ---- Production PHP settings ------------------------------------------
# Errors are still written to the PHP error log, just never shown to
# visitors (stack traces leak filesystem paths and SQL). .user.ini in this
# directory is the PHP-FPM/CGI equivalent.
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag display_startup_errors Off
    php_flag log_errors On
    php_flag session.use_strict_mode On
    php_flag session.cookie_httponly On
    php_value session.cookie_samesite Lax
</IfModule>

# ---- Block sensitive / non-public files -------------------------------
# Dotfiles (.htaccess, .user.ini, .gitkeep, .env, .git*), SQL dumps,
# archives, docs, logs, backups, editor/dev-server config, lock files.
<FilesMatch "(^\.|\.(sql|zip|tar|gz|7z|rar|md|log|bak|backup|old|orig|save|swp|swo|tmp|ini|env|lock|dist|map)$|~$|^(composer|package|package-lock|fiveserver\.config)\.(json|js)$|^index\.html$)">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ---- HTTP -> HTTPS ------------------------------------------------
    # Skipped for local development hosts. X-Forwarded-Proto covers a
    # TLS-terminating proxy/CDN in front of Apache (avoids a redirect loop).
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(:[0-9]+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # ---- Server-side-only directories ---------------------------------
    # These are only ever require()'d by PHP, never requested by a browser.
    # 404 (not 403) so their existence isn't confirmed.
    RewriteRule ^(config|database|includes|sections|\.vscode|\.git)(/|$) - [R=404,L]
    RewriteRule ^starhorse-vessel-admin/(functions|includes)(/|$) - [R=404,L]

    # Applicant resumes: only ever streamed through the admin-authenticated
    # modules/career/applicants/ajax/download_resume.php endpoint.
    RewriteRule ^starhorse-vessel-admin/uploads/career_resumes(/|$) - [R=404,L]
</IfModule>

# ---- Security headers --------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=(), fullscreen=(self)"
    Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"

    # HSTS only over HTTPS (browsers ignore it on plain HTTP anyway).
    # Deliberately WITHOUT includeSubDomains/preload — see the security
    # report before adding either; both are very hard to roll back.
    <If "%{HTTPS} == 'on' || %{HTTP:X-Forwarded-Proto} == 'https'">
        Header always set Strict-Transport-Security "max-age=31536000"
    </If>

    # Don't advertise the PHP version (expose_php itself can only be
    # turned off in the server's php.ini).
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>
